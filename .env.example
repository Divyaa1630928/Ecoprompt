# Copy this file to .env and fill in your values.
# EcoPrompt checks GEMINI_API_KEY first, then OPENAI_API_KEY.
# Leave both blank to run in DEMO MODE (no real LLM calls are made).

# ── Google Gemini (recommended) ───────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── OpenAI (optional fallback) ────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Similarity threshold for semantic cache (0.0–1.0). Higher = stricter match.
CACHE_SIMILARITY_THRESHOLD=0.85

# Cache TTL in seconds (default 86400 = 24 hours)
CACHE_TTL_SECONDS=86400

# Batch nudge window in seconds: queries within this window are eligible for batching
BATCH_WINDOW_SECONDS=60
